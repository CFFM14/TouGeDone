{
  "manifest_version": 3,
  "name": "天下人苦头歌久矣",
  "version": "2.10.1",
  "description": "单选逐题尝试，多选清洗锁定后3/4题并行、差量切换与命中拆分；支持Flash编程自动评测。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "打开天下人苦头歌久矣",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.educoder.net/tasks/*",
        "https://educoder.net/tasks/*",
        "https://trustie.educoder.net/tasks/*"
      ],
      "js": [
        "context-utils.js",
        "solution-policy.js",
        "network-bridge.js",
        "editor-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.educoder.net/tasks/*",
        "https://educoder.net/tasks/*",
        "https://trustie.educoder.net/tasks/*"
      ],
      "js": [
        "bootstrap.js",
        "context-utils.js",
        "solution-policy.js",
        "source-session.js",
        "choice-batch.js",
        "panel-ui.js",
        "page-controls.js",
        "program-runner.js",
        "helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.educoder.net/tasks/*",
    "https://educoder.net/tasks/*",
    "https://trustie.educoder.net/tasks/*",
    "https://api.deepseek.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "2.10.1 AI输出提示词修复"
}
