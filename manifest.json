{
  "manifest_version": 3,
  "name": "头歌整关助手",
  "version": "2.2.0",
  "description": "选择题助手、DeepSeek 编程题助手、混合模式可切换；自动跨关、代码预览与写入。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "打开整关助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.educoder.net/tasks/*",
        "https://educoder.net/tasks/*",
        "https://trustie.educoder.net/tasks/*"
      ],
      "js": [
        "network-bridge.js",
        "editor-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.educoder.net/tasks/*",
        "https://educoder.net/tasks/*",
        "https://trustie.educoder.net/tasks/*"
      ],
      "js": [
        "bootstrap.js",
        "helper.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.educoder.net/tasks/*",
    "https://educoder.net/tasks/*",
    "https://trustie.educoder.net/tasks/*",
    "https://api.deepseek.com/*"
  ],
  "options_page": "options.html"
}